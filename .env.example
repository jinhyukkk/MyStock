# 이 파일을 .env 로 복사한 뒤 값을 채우세요. .env 는 git에 올라가지 않습니다.

# KRX 오픈API 키 — VKOSPI 표시용. 무료 발급: https://openapi.krx.co.kr
KRX_API_KEY=

# 대시보드 경제지표 칸 (선택) — 키가 없으면 그 칸에 발급 안내가 뜹니다.
# 국내: 한국은행 ECOS 100대 지표(기준금리·물가·실업률 등). 무료: https://ecos.bok.or.kr/api
ECOS_API_KEY=
# 미국: FRED 지표 발표 일정. 무료: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# 대시보드 국내 인사이더(임원·주요주주 소유보고) + 종목상세 공시 (선택)
# 무료 발급: https://opendart.fss.or.kr  (미국 인사이더는 키 없이 야후에서 받습니다)
DART_API_KEY=

# 텔레그램 알림 (선택) — 설정 시 목표가/손절가/평단% 룰 도달을 봇으로 발송 (같은 룰은 하루 1회)
# 봇 생성: @BotFather → 토큰. chat_id: 봇에게 아무 메시지 보낸 뒤 https://api.telegram.org/bot<토큰>/getUpdates 에서 확인
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 서버 설정 (선택 — 기본값 그대로면 비워두거나 지워도 됩니다)
#PORT=80
#HOST_NAME=mystock.localhost
